# ==============================================================================
# Aurevix - Environment Configuration
# Copy this file to .env and fill in your actual credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 🗄️ Supabase Cloud Database & Authentication
# Get these from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key

# ------------------------------------------------------------------------------
# 📧 Email Notification Service (SMTP)
# Used to send login alert / security emails to the user's mail ID
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sender_gmail@gmail.com
SMTP_PASSWORD=your_16_digit_google_app_password
SMTP_SENDER_NAME="Aurevix AI Security"

# ------------------------------------------------------------------------------
# 🧠 AI Assistant API Keys (Optional / Future Upgrades)
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
